    "LinkCategory": {
      "description": "Presentation bucket of a link button. Purely visual: the engine never branches on it — the look of each category is authored once in Visuals → Link buttons.\n\n`special_icon` and `special_color` are the two parametrized categories: the former takes its icon from the link's own `iconId`, the latter its colour from the link's own `categoryColor`, so links inside them can differ from each other.",
      "enum": [
        "default",
        "action",
        "question",
        "special_icon",
        "special_color",
        "class_a",
        "class_b",
        "class_c",
        "class_d",
        "class_e"
      ],
      "type": "string"
    },
    "LinkCategoryStyle": {
      "additionalProperties": false,
      "description": "Look of one link-button category. Every field is optional — an unset field means \"inherit the stock button look / the global responses font\".",
      "properties": {
        "backgroundColor": {
          "description": "CSS colour for the button background (may be `rgba(...)` for translucency).",
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "fontId": {
          "$ref": "#/definitions/FontId",
          "description": "Font family; unset inherits the global responses font."
        },
        "fontSize": {
          "$ref": "#/definitions/FontSizeId",
          "description": "Size tier, applied as a ratio of the player's current responses size."
        },
        "iconId": {
          "description": "Icon rendered before the label. A link's own `iconId` wins over this.",
          "type": "string"
        },
        "italic": {
          "type": "boolean"
        },
        "textColor": {
          "description": "CSS colour for the label.",
          "type": "string"
        },
        "uppercase": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "LinkCategoryStyles": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "class_a": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "class_b": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "class_c": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "class_d": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "class_e": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "default": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "question": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "special_color": {
          "$ref": "#/definitions/LinkCategoryStyle"
        },
        "special_icon": {
          "$ref": "#/definitions/LinkCategoryStyle"
        }
      },
      "required": [
        "default",
        "action",
        "question",
        "special_icon",
        "special_color",
        "class_a",
        "class_b",
        "class_c",
        "class_d",
        "class_e"
      ],
      "type": "object"
    },
    "LinkDefaultsConfiguration": {
      "additionalProperties": false,
      "description": "What happens to a link button that carries no category of its own, plus the \"you have been there\" modifier that is layered on top of any category.",
      "properties": {
        "byDirectionType": {
          "description": "Style uncategorized links by their direction type. Off = stock default look.",
          "type": "boolean"
        },
        "directionTypes": {
          "$ref": "#/definitions/LinkTypeStyles",
          "description": "Per-direction-type look, used only while `byDirectionType` is on."
        },
        "markVisited": {
          "description": "Restyle links whose target the player has already visited.",
          "type": "boolean"
        },
        "visitedOpacity": {
          "description": "0-100 opacity of a visited link button.",
          "type": "number"
        },
        "visitedTextColor": {
          "description": "Label colour of a visited link; unset keeps the colour it would have had.",
          "type": "string"
        }
      },
      "required": [
        "byDirectionType",
        "directionTypes",
        "markVisited",
        "visitedOpacity"
      ],
      "type": "object"
    },
