      "overrideProps": [],
      "roles": [
        "shopkeeper"
      ],
      "avatar": {
        "list": []
      },
      "discussable": true,
      "dialog": {
        "text": {
          "main": "\"Fresh today,\" says the baker. \"What'll it be?\"",
          "list": [
            {
              "name": "again",
              "text": "\"You again,\" says the baker, not unkindly."
            }
          ]
        },
        "chooseTextScript": "return rt.props.talked ? 'again' : null",
        "background": {
          "list": []
        },
        "eventHosts": null,
        "behavior": {
          "speakingModel": {
            "agree": [
              "ok"
            ],
            "deny": [
              "no"
            ],
            "bye": [
              "bye"
            ],
            "hello": [
              "hello"
            ],
            "dontKnowObject": [
              "\"Never heard of it.\"",
              "\"Ask someone else.\""
            ],
            "dontKnowChar": [
              "\"Don't know them.\""
            ]
          },
          "reactions": [
            {
              "trigger": {
                "facts": [
                  "bread_rumour"
                ],
                "chars": [],
                "items": [],
                "places": []
              },
              "reply": "\"Ha! Everybody says that, nobody pays for it.\""
            },
            {
              "trigger": {
                "facts": [],
                "chars": [],
                "items": [],
                "places": [
                  "gate"
                ]
              },
              "reply": "",
              "dialogWindow": {
                "kind": "window",
                "dialog": "main",
                "window": "gate_story"
              }
            }
          ]
        },
        "links": [
          {
            "mainDirection": {
              "type": "reply",
              "replyText": "\"They say the bread here is better than in the capital.\""
            },
            "alternativeDirections": [],
            "text": "Listen to the gossip",
            "actionCode": "rt.facts.bread_rumour.know(); rt.props.talked = true"
          },
          {
            "mainDirection": {
              "type": "return",
              "direction": ""
            },
            "alternativeDirections": [],
            "text": "Leave"
          }
        ]
      }
    }
