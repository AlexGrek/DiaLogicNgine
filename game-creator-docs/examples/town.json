    "description": "Example for the game-creator-docs: locations and characters end to end."
  },
  "startMenu": {},
  "dialogs": [
    {
      "name": "main",
      "windows": [
        {
          "uid": "start",
          "text": {
            "main": "You wake up in a small town with an empty pocket and a curious mind.\n---\nThe square is just outside.",
            "list": []
          },
          "links": [
            {
              "mainDirection": {
                "type": "tolocation",
                "direction": "square"
              },
              "alternativeDirections": [],
              "text": "Step into the square"
            }
          ],
          "backgrounds": {
            "list": []
          },
          "tags": [],
          "specialWidget": null,
          "entryScript": "rt.props.hasKey = false; rt.props.visits = 0"
        },
        {
          "uid": "pigeons",
          "text": {
            "main": "A cloud of pigeons erupts from the fountain and the whole square forgets what it was doing.",
            "list": []
          },
          "links": [
            {
              "mainDirection": {
                "type": "pop",
                "direction": ""
              },
              "alternativeDirections": [],
              "text": "Carry on"
            }
          ],
          "backgrounds": {
            "list": []
          },
          "tags": [],
          "specialWidget": null
        },
        {
          "uid": "gate_story",
          "text": {
            "main": "The baker lowers her voice. \"The old gate? My brother kept the key under the third loaf.\"\n\nShe slides a small iron key across the counter.",
            "list": []
          },
          "links": [
            {
              "mainDirection": {
                "type": "pop",
                "direction": ""
              },
              "alternativeDirections": [],
              "text": "Take the key",
              "actionCode": "rt.props.hasKey = true"
            }
          ],
          "backgrounds": {
            "list": []
          },
          "tags": [],
          "specialWidget": null
        },
        {
          "uid": "the_end",
          "text": {
            "main": "The gate swings open on a quiet road that goes somewhere else.\n\nTHE END",
            "list": []
          },
          "links": [
            {
              "mainDirection": {
                "type": "resetjump",
                "qualifiedDirection": {
                  "kind": "window",
                  "dialog": "main",
                  "window": "start"
                }
              },
              "alternativeDirections": [],
              "text": "Play again"
            }
          ],
          "backgrounds": {
            "list": []
          },
          "tags": [],
          "specialWidget": null
        }
      ]
    }
  ],
  "facts": [
    {
      "uid": "bread_rumour",
      "short": "The bakery's bread is famous",
      "full": "People say the bakery's bread beats the capital's.",
      "discussable": true
    }
  ],
  "chars": [
    {
      "uid": "baker",
      "displayName": {
        "main": "Baker",
        "list": []
      },
      "description": {
        "main": "Bakes before sunrise and knows everyone's business.",
        "list": []
      },
      "traits": [],
      "props": [
        {
          "name": "mood",
          "datatype": "string",
          "defaultValue": "cheerful"
